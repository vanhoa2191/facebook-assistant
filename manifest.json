{
  "manifest_version": 3,
  "name": "Facebook AI Assistant",
  "version": "0.4.0",
  "description": "Trợ lý AI Facebook: quản lý nhóm, bản nháp, Gemini, Page Graph API và lịch nhắc việc.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "action": {
    "default_title": "Mở Facebook AI Assistant"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "options_page": "dashboard.html",
  "optional_host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://graph.facebook.com/*"
  ]
}
