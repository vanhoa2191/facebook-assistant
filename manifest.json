{
  "manifest_version": 3,
  "name": "Facebook AI Assistant",
  "version": "0.7.0",
  "description": "Trợ lý AI Facebook: Meta AI Web, hàng đợi duyệt nội dung và đăng Page có xác nhận.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "action": {
    "default_title": "Mở Facebook AI Assistant"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "options_page": "dashboard.html",
  "optional_host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://graph.facebook.com/*",
    "https://meta.ai/*",
    "https://www.meta.ai/*"
  ],
  "optional_permissions": [
    "scripting"
  ]
}
